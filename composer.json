{
    "name": "grazulex/laravel-chronoview",
    "description": "Horizon-style dashboard for the Laravel scheduler: every run, every failure, every missed run",
    "keywords": ["laravel", "scheduler", "cron", "monitoring", "dashboard", "schedule", "missed-runs", "heartbeat"],
    "homepage": "https://github.com/grazulex/laravel-chronoview",
    "license": "MIT",
    "authors": [
        {
            "name": "Jean-Marc Strauven",
            "email": "jms@grazulex.be",
            "homepage": "https://grazulex.be",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "dragonmantank/cron-expression": "^3.3",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/events": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0",
        "nesbot/carbon": "^3.10"
    },
    "require-dev": {
        "larastan/larastan": "^3.4",
        "laravel/pint": "^1.22",
        "orchestra/testbench": "^10.2|^11.0",
        "pestphp/pest": "^3.8|^4.0",
        "pestphp/pest-plugin-laravel": "^3.2|^4.0",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Grazulex\\ChronoView\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Grazulex\\ChronoView\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": ["@clear", "@prepare"],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": "pint -v",
        "rector": "rector process",
        "test:lint": "pint --test -v",
        "test:types": "phpstan analyse",
        "test:unit": "pest --colors=always",
        "test": ["@test:lint", "@test:types", "@test:unit"],
        "full": ["@test:lint", "@test:types", "@test:unit"]
    },
    "extra": {
        "laravel": {
            "providers": ["Grazulex\\ChronoView\\ChronoViewServiceProvider"],
            "aliases": {"ChronoView": "Grazulex\\ChronoView\\Facades\\ChronoView"}
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {"pestphp/pest-plugin": true}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
